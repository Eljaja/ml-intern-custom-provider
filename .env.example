# Hugging Face — needed for Hub tools, datasets, MCP. Optional if the active LLM
# uses CUSTOM_INFERENCE_* only (see README).
# https://huggingface.co/settings/tokens
# HF_TOKEN=

# Optional: route specific model ids to a private OpenAI-compatible API (TGI, vLLM, etc.)
# When set, only matching base ids (before any :fastest / :provider suffix) use this endpoint;
# all other org/model names still go through the Hugging Face router.
# CUSTOM_INFERENCE_API_BASE=https://example.com/v1
# CUSTOM_INFERENCE_API_KEY=sk-...
# CUSTOM_INFERENCE_MODEL=minimax/minimax-m2.7
# (comma-separated list is supported, e.g. "org/a,org/b")
# Do not set OPENAI_API_KEY to a different/empty value — LiteLLM may prefer it for openai/ models.

# Web backend: use local shell/read/write (same as CLI) on the *machine running uvicorn*.
# If unset, the agent uses a remote Hugging Face sandbox (sandbox_create + bash in Space).
# AGENT_LOCAL_MODE=1

# AGENT_LOCAL_MODE=1 without OAUTH_CLIENT_ID means the agent runs arbitrary
# commands for any unauthenticated caller. backend/runtime_guard.py refuses to
# start in that combination unless you acknowledge it here. Only set it when the
# port is bound to loopback on a trusted host; otherwise configure HF OAuth.
# docker-compose.yaml sets it and publishes on 127.0.0.1 only.
# ML_INTERN_ALLOW_UNAUTHENTICATED_LOCAL_MODE=1

# Docker Compose (`docker compose up`) sets MONGODB_URI, ML_INTERN_SKILLS_DIR, and
# AGENT_LOCAL_MODE on the backend service and mounts named volumes so sessions, code,
# and skills survive image rebuilds. Override here only if you run the stack differently.
# MONGODB_URI=mongodb://mongo:27017
# MONGODB_DB=ml-intern
# ML_INTERN_SKILLS_DIR=/data/ml-intern/skills
# ML_INTERN_WORKSPACE=/app/backend/workspace

# Optional: Zulip notifications (stream messages). Requires a bot API key.
# ML_INTERN_ZULIP_NOTIFICATIONS=1
# ZULIP_SITE=https://chat.example.com
# ZULIP_BOT_EMAIL=ml-intern-bot@example.com
# ZULIP_API_KEY=
# ZULIP_STREAM=ml-agent
# ZULIP_TOPIC=ml-intern
# ML_INTERN_ZULIP_DESTINATION=zulip.default
# ML_INTERN_ZULIP_ALLOW_AGENT_TOOL=1
# ML_INTERN_ZULIP_ALLOW_AUTO_EVENTS=1
# ML_INTERN_ZULIP_AUTO_EVENTS=approval_required,error,turn_complete
# For private messages instead of a stream:
# ZULIP_MESSAGE_TYPE=private
# ZULIP_TO=user@example.com

ANTHROPIC_API_KEY=
GITHUB_TOKEN=
