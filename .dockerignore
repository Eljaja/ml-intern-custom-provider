# Git
.git
.gitignore

# Python
.venv
**/__pycache__
**/*.pyc
**/.pytest_cache
**/*.pyo
**/.mypy_cache
**/.ruff_cache
*.egg-info
dist
build

# Node / front
frontend/node_modules
frontend/dist
**/node_modules

# IDE / local
.vscode
.idea
*.log

# Do not ship local secrets in the build context. They are passed at runtime
# instead: docker-compose.yaml uses `env_file: .env`, which is read when the
# container starts, not when the image is built — so excluding them here costs
# nothing. The line below was previously commented out, which meant the comment
# described an intent the file did not enforce.
.env
.env.*
!.env.example

# Large / dev-only
**/*.pyc
session_logs
static
